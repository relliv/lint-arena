    {
      "id": "default-param-last",
      "eslint": "@typescript-eslint/default-param-last",
      "oxlint": "default-param-last",
      "biome": "style/useDefaultParameterLast",
      "deno": "default-param-last"
    },
    {
      "id": "eqeqeq",
      "eslint": "eqeqeq",
      "oxlint": "eqeqeq",
      "biome": "suspicious/noDoubleEquals",
      "deno": "eqeqeq",
      "biomeOptions": {
        "ignoreNull": false
      }
    },
    {
      "id": "for-direction",
      "eslint": "for-direction",
      "oxlint": "for-direction",
      "biome": "correctness/useValidForDirection",
      "deno": "for-direction"
    },
    {
